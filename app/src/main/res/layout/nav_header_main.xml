<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="26dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/imgAppLogo"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_drawer_app_logo"
        android:contentDescription="@string/app_name"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_drawer_app_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quản lý danh bạ"
        android:textColor="@color/cm_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Chuyên nghiệp"
        android:textColor="@color/cm_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
