<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_purple">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar_outline"
                android:tint="@color/cm_purple_icon"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/cm_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnEdit"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_edit_outline"
                    android:tint="@color/cm_text_secondary" />

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_delete_outline"
                    android:tint="@color/cm_danger" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/cm_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/cm_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/cm_text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cm_text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cm_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/cm_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDone"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_success_soft"
            android:text="Hoàn tất"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:drawableTint="@android:color/white"
            android:textSize="11sp"
            android:paddingHorizontal="4dp"
            android:drawableStart="@drawable/ic_check_circle_outline"
            android:drawablePadding="6dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger_soft"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:drawableTint="@android:color/white"
            android:textSize="11sp"
            android:paddingHorizontal="4dp"
            android:drawableStart="@drawable/ic_cancel_circle_outline"
            android:drawablePadding="6dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCall"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_call_soft"
            android:text="Gọi"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:drawableTint="@android:color/white"
            android:textSize="11sp"
            android:paddingHorizontal="4dp"
            android:drawableStart="@drawable/ic_phone_button_outline"
            android:drawablePadding="6dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEmail"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_email_soft"
            android:text="Email"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:drawableTint="@android:color/white"
            android:textSize="11sp"
            android:paddingHorizontal="4dp"
            android:drawableStart="@drawable/ic_email_button_outline"
            android:drawablePadding="6dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
