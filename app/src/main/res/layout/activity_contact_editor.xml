<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại"
                android:textColor="@color/cm_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Danh bạ"
                android:textColor="@color/cm_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu"
                android:textColor="@color/cm_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_soft"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_soft" android:hint="Tên *" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Email" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etPhonePrimary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Số điện thoại chính *" android:inputType="phone" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Số phụ"
                android:textColor="@color/cm_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/secondaryPhonesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnAddSecondaryPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_idle"
                android:gravity="center"
                android:text="+ Thêm số phụ"
                android:textColor="@color/cm_primary"
                android:textStyle="bold" />

            <EditText android:id="@+id/etCompany" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Công ty" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etPosition" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Chức vụ" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etDepartment" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Phòng ban" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Địa chỉ" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
            <EditText android:id="@+id/etBirthday" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:hint="Ngày sinh" android:paddingHorizontal="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nhãn"
                android:textColor="@color/cm_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTag"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_soft"
                android:entries="@array/contact_labels"
                android:paddingHorizontal="12dp" />

            <EditText android:id="@+id/etNote" android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_soft" android:gravity="top|start" android:hint="Ghi chú" android:padding="16dp" android:textColor="@color/cm_text_primary" android:textColorHint="@color/cm_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
